// ─── TUBA AL HIJAZ — PostgreSQL schema (Prisma) ──────────────────────────────
// Source of truth for entities/fields/enums: docs/AUDIT.md (Phase 1 audit).
// Conventions:
//  - Every business record keeps a human-facing `code` (e.g. GRP-1446-2891,
//    INV-1446-0091) following {PREFIX}-{HijriSeason}-{serial}; the DB pk is a cuid.
//  - `tenantId` → Company.id row-level multi-tenancy on all agent-scoped data
//    (agents must never see other agents' rows). Supplier-side scoping uses
//    `supplierId`. Platform/internal rows have tenantId = null where nullable.
//  - Money: Decimal(14,2) in SAR unless a currency column says otherwise.
//    FX rates: Decimal(12,4). VAT 15%, platform fee 2.5% applied in service layer.
//  - Dates are UTC timestamps; Hijri display strings are kept only where the UI
//    shows them verbatim (e.g. CR issue/expiry) alongside a real DateTime.
//  - Bilingual content columns use the `xxxBn` suffix (Bangla default in UI).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

