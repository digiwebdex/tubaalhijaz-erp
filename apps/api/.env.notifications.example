# ─── Phase 11 · Notification delivery credentials ─────────────────────────────
# Copy these into the gitignored apps/api/.env and fill in real values to enable
# live WhatsApp + Email sends. With them unset, both channels run in stub mode
# (SKIPPED → the notification stays PENDING) and everything else still works.

# WhatsApp — WASender API (https://wasenderapi.com)
WASENDER_API_URL=https://www.wasenderapi.com/api   # default; override only if self-hosted
WASENDER_API_KEY=                                   # Bearer token from your connected WASender session

# Email — SMTP (nodemailer)
SMTP_HOST=                    # e.g. smtp.gmail.com  /  smtp.sendgrid.net
SMTP_PORT=587                 # 587 STARTTLS (SMTP_SECURE=false) | 465 TLS (SMTP_SECURE=true)
SMTP_SECURE=false
SMTP_USER=                    # SMTP username (e.g. apikey for SendGrid, full address for Gmail)
SMTP_PASS=                    # SMTP password / app password / API key
SMTP_FROM=TUBA AL HIJAZ <no-reply@tubalhijaz.com>

# Redis (already set by Phase 10) — reused for the tuba-notify queue
# REDIS_URL=redis://127.0.0.1:6399/3
