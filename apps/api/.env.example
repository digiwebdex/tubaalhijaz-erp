# TUBA AL HIJAZ API — copy to .env and fill in real values (never commit .env)
PORT=3210

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://tuba:CHANGE_ME@localhost:5432/tuba_al_hijaz?schema=public

# Auth
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRES_IN=15m
# Cookie Path for tuba_rt — use /api/auth when the SPA calls https://host/api (nginx prefix)
REFRESH_COOKIE_PATH=/auth
COOKIE_SECURE=false

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# T001-01: when true/1/yes, HAJJ and UMRAH group create/update require hajiWhatsapp.
# Default off so legacy clients remain backward compatible.
# REQUIRE_HAJI_WHATSAPP=false

# T001-07: when true/1/yes, OCR type NUSUK_GROUP_LIST is accepted (approve → Group).
# Default off — passport OCR unchanged; Group List mode hidden/rejected until enabled.
# ENABLE_NUSUK_GROUP_LIST_OCR=false

# T002-05 SOP: when true/1/yes, ISSUED must pass PASSPORT_RETURNED before COMPLETED.
# Default off — ISSUED → COMPLETED skip is allowed (architecture §3.5).
# VISA_REQUIRE_PASSPORT_RETURN=false

# T002-06: when true/1/yes, enable MOFA Processing Bill Sheet API/UI (Finance).
# Default off until Finance ready. MOFA Number on Passenger remains separate.
# ENABLE_MOFA_PROCESSING_BILL=false

# T002-07: when true/1/yes (default when unset for LS host pack), Host WhatsApp is mandatory.
# REQUIRE_LONGSTAY_HOST_WHATSAPP=true

