# syntax=docker/dockerfile:1
# ─── TUBA AL HIJAZ · API image (NestJS + Prisma) ─────────────────────────────
# Multi-stage: a fat builder compiles the workspace, a slim runner ships only
# production deps + built output. Build context is the repo root (monorepo).

# ── Builder ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
WORKDIR /app

# Install deps first (layer cached until a manifest changes).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

# Build shared → generate Prisma client → build the API.
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @tuba/shared build \
 && pnpm --filter @tuba/api exec prisma generate \
 && pnpm --filter @tuba/api build

# ── Runner (production) ──────────────────────────────────────────────────────
FROM node:22-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends openssl wget \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
ENV NODE_ENV=production
WORKDIR /app

# Production-only deps (prisma is a runtime dependency → CLI present for migrations).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --prod

# Built artifacts + Prisma schema/migrations, then generate the client into the
# production node_modules (native engine for this linux image).
COPY --from=builder /app/packages/shared/dist packages/shared/dist
COPY --from=builder /app/apps/api/dist apps/api/dist
COPY apps/api/prisma apps/api/prisma
RUN pnpm --filter @tuba/api exec prisma generate

WORKDIR /app/apps/api
EXPOSE 3210
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3210/health >/dev/null 2>&1 || exit 1

# Apply pending migrations, then boot. (migrate deploy is safe + idempotent.)
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]
