# ─── TUBA AL HIJAZ · STAGING compose env ──────────────────────────────────────
# Copy to infra/.env INSIDE THE STAGING CHECKOUT (/var/www/TUBAALHIJAZ-staging),
# never into the production checkout. chmod 0600. Gitignored — never commit real values.
#
# Staging exists so a new Figma export can be seen against real-shaped data WITHOUT
# any chance of touching production. Every value below is chosen for that isolation.

# ── Postgres — MUST NOT match production ──────────────────────────────────────
# The volume is already isolated by the compose project name (tuba-staging_pgdata),
# but use distinct credentials too so a mis-pointed DATABASE_URL fails loudly
# instead of silently connecting to the wrong database.
POSTGRES_USER=tuba_staging
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=tubaalhijaz_staging

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=tuba_staging
MINIO_ROOT_PASSWORD=          # generate: openssl rand -base64 24
STORAGE_BUCKET=tuba-docs-staging

# ── API secrets — MUST differ from production ────────────────────────────────
# A distinct JWT_SECRET means a staging token is rejected by prod and vice versa.
# Sharing it would let a staging session authenticate against the live API.
JWT_SECRET=                   # generate: openssl rand -base64 48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=true
# Same as prod: browser URL is /api/auth/* under nginx
REFRESH_COOKIE_PATH=/api/auth

# ── Host-exposed ports — every one MUST differ from production ────────────────
# Production uses API 3210 · WEB 8095 · MinIO 9000/9001 · Grafana 3007.
# BIND_ADDR=127.0.0.1 keeps staging off the public interface entirely: it is
# reachable only through nginx, which fronts it with HTTP basic auth.
BIND_ADDR=127.0.0.1
API_PORT=3211
WEB_PORT=8096
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
POSTGRES_PORT=5442
REDIS_PORT=6389

# ── Images ────────────────────────────────────────────────────────────────────
# Staging pulls CI-built images tagged with the STAGING branch SHA. It never builds
# on the box (the VPS disk is tight and a build would compete with production).
REGISTRY=                     # ghcr.io/<owner>
IMAGE_TAG=                    # set by CI on each staging deploy (git SHA)

# ── Origins ───────────────────────────────────────────────────────────────────
VITE_API_URL=https://staging.tubaalhijaz.com/api
WEB_ORIGIN=https://staging.tubaalhijaz.com

# ── Notification delivery — DELIBERATELY BLANK. DO NOT FILL IN. ───────────────
# This is the most important safety property of the staging environment.
# Staging runs against a copy of real-shaped data, including real agent phone
# numbers and email addresses. If these were set, a staging deploy would send
# real WhatsApp messages and real emails to real customers.
#
# Both channels fail safe when unset (verified in the source, not assumed):
#   • whatsapp.channel.ts — `if (!this.apiKey) return { status: "SKIPPED" }`
#   • email.channel.ts    — no SMTP_HOST ⇒ "stub mode", transport never created
# Notifications are still QUEUED and LOGGED, so the automation engine and the
# notification history UI can be exercised end-to-end — nothing is transmitted.
WASENDER_API_URL=
WASENDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Staging is not monitored by the Phase 18 Prometheus/Grafana stack; that stack
# scrapes the production project only. Leave blank — do not start a second Grafana.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=
