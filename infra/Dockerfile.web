# syntax=docker/dockerfile:1
# ─── TUBA AL HIJAZ · Web image (Vite SPA → Nginx) ────────────────────────────
# Builds the static SPA and serves it from Nginx. The SPA talks to the API on a
# separate origin via VITE_API_URL (see infra/README.md "Why a separate origin").
# Build context is the repo root (monorepo).

# ── Builder ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/web apps/web

# VITE_API_URL is baked at build time (Vite inlines import.meta.env.*).
ARG VITE_API_URL=http://localhost:3210
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm --filter @tuba/shared build && pnpm --filter @tuba/web build

# ── Runner (Nginx static) ────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner
COPY infra/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
