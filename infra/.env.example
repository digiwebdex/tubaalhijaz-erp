# ─── TUBA AL HIJAZ · compose env ──────────────────────────────────────────────
# Copy to infra/.env and fill in real secrets. infra/.env is gitignored.
# Both docker-compose.yml (dev) and docker-compose.prod.yml read this file.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=tuba
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=tuba_al_hijaz

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=tuba-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
STORAGE_BUCKET=tuba-docs

# ── API secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=14
COOKIE_SECURE=false          # local/http: false. Production HTTPS: must be true (infra/.env)
# Refresh cookie Path must match the *browser* URL path (RFC 6265), not Nest's mount path.
# Direct API (localhost:3210/auth/...): /auth
# Nginx strips /api → Nest sees /auth, but browser URL is /api/auth/... → must be /api/auth
REFRESH_COOKIE_PATH=/auth

# ── Host-exposed ports ────────────────────────────────────────────────────────
# BIND_ADDR: 0.0.0.0 publishes to the public interface; set 127.0.0.1 on a shared
# box so only the local reverse-proxy (nginx) can reach these — nothing is public
# until TLS fronts it.
BIND_ADDR=0.0.0.0
API_PORT=3210
WEB_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432           # dev compose only
REDIS_PORT=6379              # dev compose only

# ── Images (registry + tags) ──────────────────────────────────────────────────
# REGISTRY: local build namespace by default; on the VPS set to your GHCR owner
# path so `docker compose pull` fetches CI-built images, e.g. ghcr.io/<owner>.
#
# WEB_IMAGE_TAG / API_IMAGE_TAG: INDEPENDENT tags for web and api so they can
# never collide. Set each to the tag that service should run. IMAGE_TAG is a
# legacy shared fallback used only when a split var is unset.
#
# ALWAYS deploy ONE service at a time with --no-deps so the other is untouched:
#   WEB_IMAGE_TAG=<tag> docker compose -f docker-compose.prod.yml up -d --no-deps web
#   API_IMAGE_TAG=<tag> docker compose -f docker-compose.prod.yml up -d --no-deps api
# NEVER run a bare `docker compose up -d` (no service): api uses env_file:[.env],
# so a bare up would recreate api on any .env change (safe if the tag is current,
# but avoid the surprise — always name the service + --no-deps).
REGISTRY=tuba-alhijaz
IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
API_IMAGE_TAG=latest

# ── Origins ───────────────────────────────────────────────────────────────────
# The browser SPA calls the API at VITE_API_URL (baked into the web image at build).
# CORS on the API must allow the web origin (WEB_ORIGIN).
VITE_API_URL=http://localhost:3210
WEB_ORIGIN=http://localhost:8080

# ── Notification delivery (optional — blank = stub mode, see docs/NOTIFICATIONS.md)
WASENDER_API_URL=https://www.wasenderapi.com/api
WASENDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TUBA AL HIJAZ <no-reply@tubalhijaz.com>

# ── Monitoring (Phase 18) ──
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
GRAFANA_PORT=3001

# ── Off-VPS backup (Phase 18, item 4 — leave blank to keep backups on-box only) ──
# Backblaze B2 / any S3-compatible: endpoint host, bucket, and keys.
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_KEY=
OFFSITE_SECRET=
